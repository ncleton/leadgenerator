{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaka-performance.example/schemas/leadgenerator/client-pack-v1.json",
  "title": "Lead Generator client pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "leadgenerator.yaka/v1"},
    "kind": {"const": "ClientPack"},
    "metadata": {"type": "object", "required": ["id", "version"]},
    "spec": {
      "type": "object",
      "required": ["plugins", "ui"],
      "properties": {
        "extends": {"type": "array", "items": {"type": "string"}},
        "plugins": {"type": "object"},
        "ui": {"type": "object"},
        "campaigns": {"type": "array"},
        "scorecards": {"type": "array"}
      }
    }
  }
}
