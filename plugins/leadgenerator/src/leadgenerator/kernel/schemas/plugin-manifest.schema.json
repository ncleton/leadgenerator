{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaka-performance.example/schemas/leadgenerator/plugin-manifest-v1.json",
  "title": "Lead Generator plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "leadgenerator.yaka/v1"},
    "kind": {"const": "Plugin"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "tier"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
        "tier": {"enum": ["native", "client"]}
      }
    },
    "spec": {"type": "object", "required": ["requiresSdk", "runtime", "configuration"]}
  }
}
