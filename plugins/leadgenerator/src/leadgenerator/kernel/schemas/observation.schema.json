{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaka-performance.example/schemas/leadgenerator/observation-v1.json",
  "title": "Lead Generator observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "subject_type", "subject_id", "objective_id", "kind", "status", "plugin_id", "plugin_version"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["company", "establishment", "contact", "objective"]},
    "subject_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "status": {"enum": ["fact", "inference", "hypothesis", "missing"]},
    "value": {},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "plugin_id": {"type": "string"},
    "plugin_version": {"type": "string"},
    "schema_version": {"type": "string"}
  }
}
